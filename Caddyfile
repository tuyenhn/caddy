{
	email hntuyen282@gmail.com

	log {
		format console
	}

	servers {
		trusted_proxies static 10.28.2.55/32
	}
}

# Usage, in sites/*.caddy:
#   import proxied_site <hostname> <upstream>
(proxied_site) {
	http://{args[0]}:80 {
		@trusted remote_ip 10.28.2.55/32
		handle @trusted {
			reverse_proxy {args[1]}
		}

		handle {
			respond "Not requesting from the correct proxy" 403
		}
	}
}

import sites.caddy

# Anything else hitting :80 (bare IP, unknown Host) gets nothing.
http://:80 {
	abort
}
